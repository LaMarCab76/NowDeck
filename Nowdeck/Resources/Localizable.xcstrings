      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PLAYING"
          }
        }
      }
    },
    "SPOTIFY PIDE ESPERAR" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SPOTIFY ASKS TO WAIT"
          }
        }
      }
    },
    "Se abre el inicio de sesión de Spotify. Después volvés solo a Nowdeck." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify's sign-in opens. Afterwards you come back to Nowdeck automatically."
          }
        }
      }
    },
    "Se cerró el inicio de sesión. Si Spotify mostró un error, revisá el Client ID y que el Redirect URI sea nowdeck://callback." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in was closed. If Spotify showed an error, check the Client ID and that the Redirect URI is nowdeck://callback."
          }
        }
      }
    },
