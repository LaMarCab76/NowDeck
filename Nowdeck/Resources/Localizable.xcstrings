    "Revisá la conexión a internet. Nowdeck vuelve a probar solo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your internet connection. Nowdeck will retry on its own."
          }
        }
      }
    },
    "Revisá que tu cuenta siga en Users Management, en los ajustes de tu app en el panel de Spotify, y que la cuenta dueña de la app tenga Premium. Nowdeck vuelve a probar solo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that your account is still in User Management, in your app's settings on the Spotify dashboard, and that the account that owns the app has Premium. Nowdeck will retry on its own."
          }
        }
      }
    },
    "SIN ACTUALIZAR" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NOT UPDATING"
          }
        }
      }
    },
