# Local per-developer config (team, bundle ID override)
Config/Local.xcconfig

# Build output and user state
DerivedData/
build/
xcuserdata/
*.xcuserstate
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Package.resolved
